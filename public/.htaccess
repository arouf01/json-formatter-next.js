# Single-Page App routing for Apache / cPanel.
# Serve index.html for any path that is not a real file or directory, so that
# client-side routes (React Router) work on direct load and on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
